@prefix ex: <https://example.org/oake/allsky/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix saref: <https://saref.etsi.org/core/> .
@prefix schema: <https://schema.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Fictional test chronology: NOT verified dates for the actual installation.
ex:camera a sosa:Sensor, schema:Product ;
    rdfs:label "Example AllSky camera"@en ;
    schema:model ex:camera-model .
ex:camera-model a schema:ProductModel ; schema:name "ZWO ASI678MC" .

ex:lens-a a schema:Product ; schema:model ex:lens-model-a .
ex:lens-model-a a schema:ProductModel ; schema:name "M12 1.85 mm" .
ex:lens-b a schema:Product ; schema:model ex:lens-model-b .
ex:lens-model-b a schema:ProductModel ; schema:name "Example replacement lens" .

# Provisional part-whole property: semantic validation pending.
ex:configuration-1 a prov:Entity ;
    saref:consistsOf ex:camera, ex:lens-a ;
    time:hasTime ex:interval-1 .
ex:interval-1 a time:Interval ;
    time:hasBeginning [ a time:Instant ; time:inXSDDateTimeStamp "2025-01-01T00:00:00Z"^^xsd:dateTimeStamp ] ;
    time:hasEnd [ a time:Instant ; time:inXSDDateTimeStamp "2026-01-01T00:00:00Z"^^xsd:dateTimeStamp ] .

ex:configuration-2 a prov:Entity ;
    saref:consistsOf ex:camera, ex:lens-b ;
    time:hasTime ex:interval-2 .
ex:interval-2 a time:Interval ;
    time:hasBeginning [ a time:Instant ; time:inXSDDateTimeStamp "2026-01-01T00:00:00Z"^^xsd:dateTimeStamp ] ;
    time:hasEnd [ a time:Instant ; time:inXSDDateTimeStamp "2027-01-01T00:00:00Z"^^xsd:dateTimeStamp ] .
